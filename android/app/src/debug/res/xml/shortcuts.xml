<?xml version="1.0" encoding="utf-8"?>
<!-- COPY of src/main/res/xml/shortcuts.xml for the .debug package
     (targetPackage cannot use ${applicationId}). test/android/manifest_test.dart
     fails if the two drift. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_session"
        android:enabled="true"
        android:icon="@drawable/ic_stat_pi"
        android:shortcutShortLabel="@string/shortcut_new_session"
        android:shortcutLongLabel="@string/shortcut_new_session_long">
        <intent
            android:action="us.snakepit.omai.action.SHORTCUT"
            android:targetPackage="us.snakepit.omai.debug"
            android:targetClass="us.snakepit.omai.MainActivity">
            <extra android:name="route" android:value="new_session"/>
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="needs_you"
        android:enabled="true"
        android:icon="@drawable/ic_stat_pi"
        android:shortcutShortLabel="@string/shortcut_needs_you"
        android:shortcutLongLabel="@string/shortcut_needs_you_long">
        <intent
            android:action="us.snakepit.omai.action.SHORTCUT"
            android:targetPackage="us.snakepit.omai.debug"
            android:targetClass="us.snakepit.omai.MainActivity">
            <extra android:name="route" android:value="needs_you"/>
        </intent>
    </shortcut>
</shortcuts>
